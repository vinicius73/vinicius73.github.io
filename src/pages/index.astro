---
import Layout from "../layouts/Layout.astro";
import About from "../components/sections/About.astro";
---

<Layout>
  <section class="grid gap-10 md:grid-cols-[minmax(0,0.4fr)_minmax(0,1fr)]">
    <div class="space-y-8">
      <div
        class="glitch-screen rounded-lg"
        style="
          --glitch-image: url('/cover.webp');
          --glitch-duration: 2s;
          --glitch-iterations: 1;
          --glitch-final-filter: none;
          --glitch-shake-amount: 4px;
        "
      >
        <img
          src="/cover.webp"
          alt="Foto de Vinicius"
          class="h-auto w-full max-h-[520px] rounded-lg object-cover"
        />
      </div>
      <div class="space-y-2">
        <h1 class="profile-name">Vinicius Reis</h1>
        <p class="profile-role">Severino Full-Stack Developer 🤓</p>
      </div>
    </div>

    <div class="space-y-10">
      <About />
    </div>
  </section>
</Layout>
