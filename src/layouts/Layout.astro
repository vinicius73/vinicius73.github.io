---
import "../styles/globals.css";
import Header from "../components/Header.astro";

const { title = "Vinicius Reis - Severino Full-Stack Developer 🤓" } =
  Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="og:description" content="Severino Full-Stack Developer 🤓" />
    <meta name="og:title" content="Vinicius Reis" />
    <meta
      name="og:image"
      content="https://gravatar.com/avatar/f803c45d62a468e0cb990398c004bd3e?s=400&d=robohash&r=x"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="page-body">
    <div class="page-wrapper">
      <Header />
      <main class="page-main">
        <slot />
      </main>
    </div>
  </body>
</html>
